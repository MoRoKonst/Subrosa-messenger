.env

# QR-картинки/секреты кодов доступа сервера — генерируются локально, не для репозитория
access_codes_qr/
Server/access_codes_qr/
.env.*
!.env.example
!**/.env.example

# Firebase Client Config (содержит API ключ — каждый деплоит с своим Firebase)
app/google-services.json

# Скомпилированные APK (публикуются через GitHub Releases, не через git)
app/release/

# TLS-сертификаты и приватные ключи сервера
*.pem
*.key
Server/.key
certs/
nginx-cache/
beacon-data/

# Установщики и дистрибутивы (не должны быть в репозитории)
*.exe
*.exe.*
*.part
Server/gradle-*/
Server/android-studio*/

# Папка биля
папка биля/

# Python bytecode cache
__pycache__/
*.pyc
.pytest_cache/

# Runtime logs / scratch output
*.log
meminfo_watch.log

# Статья (черновик, публикуется отдельно)
Статья.md

# Внутренний план подготовки к security-аудиту — не для публичного репо
docs/AUDIT_PREPARATION_NEXT_STEPS.md

