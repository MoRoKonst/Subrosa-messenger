# Beacon Messenger Server Configuration

# Admin secret for channel creation codes
# IMPORTANT: Change this to a strong random value in production
# Generate with: openssl rand -hex 32
CHANNEL_ADMIN_SECRET=your-secure-secret-here-change-this

# Server configuration
BEACON_HOST=0.0.0.0
BEACON_PORT=9000

# Optional: TURN server credentials (for WebRTC calls)
# TURN_SERVER=turn:your-turn-server.com:3478
# TURN_USERNAME=user
# TURN_PASSWORD=password

# Optional: Firebase credentials for push notifications
# FIREBASE_CREDENTIALS_JSON=path/to/firebase-credentials.json
