# Subrosa Messenger — server configuration
#
#   cp .env.example .env
#
# This file is the template for the DOCKER deployment (deploy/docker-compose.yml
# loads it via `env_file: ../.env`, so it must stay at the repository root even
# though compose itself is run from deploy/). The manual, non-Docker path has
# its own template at Server/.env.example.
#
# READ THE "AT-REST PROTECTION" SECTION BELOW BEFORE YOUR FIRST START.
# Two of those keys cannot be added later without starting from an empty
# database, and leaving them empty means the server stores its database
# unencrypted. The server will print which protections are off every time it
# starts, so you can always check what a running deployment is actually doing.


# ─── Network ──────────────────────────────────────────────────────────────────

# Address the server binds to inside the container. Leave as-is for Docker:
# nginx terminates TLS and reaches the server over the compose network, and
# port 9000 is published on 127.0.0.1 only.
SUBROSA_HOST=0.0.0.0
SUBROSA_PORT=9000

# Public WebSocket address of THIS server. Required only for federation (a
# "son" server announces this to its "father" so clients receive a current
# list of fallback servers). Leave empty for a single standalone server.
#   Example: wss://messenger.example.com  or  wss://messenger.example.com:4433
SERVER_URL=


# ─── At-rest protection ───────────────────────────────────────────────────────
#
# Message CONTENT is end-to-end encrypted and the server never holds the keys
# for it — that is true regardless of anything in this section. What these two
# keys protect is the server's own SQLite file: the offline message queue,
# registration records, routing tokens and TOTP secrets. Without them, that
# file is plaintext on disk, so a stolen backup, a cloud snapshot or a seized
# powered-off disk hands over everything the server knows about who talks to
# whom and when.
#
# Neither key protects against an attacker with root on the RUNNING server:
# the process must hold both in memory to read its own data.

# DB_ENCRYPTION_KEY_HEX — encrypts the whole database (messages.db) via
#   SQLCipher. Requires the sqlcipher3-binary package, which is already in
#   Server/requirements.txt and therefore in the Docker image.
#
#   Generate:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
#
#   SET THIS BEFORE YOUR FIRST START, or start from an empty database. An
#   existing UNENCRYPTED database will NOT open once this key is set — the
#   server fails to start rather than silently losing your data. Migrating an
#   existing deployment means exporting, wiping the volume, and re-importing.
#
#   If this is empty, the server starts normally with an unencrypted database.
DB_ENCRYPTION_KEY_HEX=

# TOTP_SECRET_ENCRYPTION_KEY — encrypts stored TOTP secrets (used by the
#   device-gated registration protection) inside the database. Worth setting
#   even with DB_ENCRYPTION_KEY_HEX on: keep this key somewhere your database
#   backups do NOT go, so a leaked backup alone is not enough.
#
#   Generate:
#     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
#   Unlike the database key, this one CAN be added to a running deployment:
#   existing plaintext rows keep working and are re-encrypted the next time
#   each account's secret is saved. But once set it must stay set and correct —
#   the server refuses to start rather than silently reverting to plaintext.
TOTP_SECRET_ENCRYPTION_KEY=


# ─── Access control ───────────────────────────────────────────────────────────

# SERVER_ACCESS_PROTECTED — set to "true" for a private or firm deployment.
#   Registering a NEW account then requires a one-time access code (reconnects
#   of already-known accounts are unaffected). Leave empty for a personal
#   server you are the only user of.
#
#   WITHOUT THIS, ANYONE WHO CAN REACH YOUR SERVER CAN REGISTER ON IT. That is
#   the right default for a personal server and the wrong one for a firm.
SERVER_ACCESS_PROTECTED=

# SERVER_ACCESS_CODE_COUNT — how many one-time codes to generate on the first
#   start with SERVER_ACCESS_PROTECTED=true (e.g. 16, one per employee). They
#   are printed to the log ONCE at startup. To issue more later without a
#   restart:  python3 Server/admin_gen_codes.py <N>
SERVER_ACCESS_CODE_COUNT=


# ─── Federation (optional) ────────────────────────────────────────────────────

# FEDERATION_SECRET — shared secret, IDENTICAL on every server in the
#   federation. Leave empty for a standalone server.
#   Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
FEDERATION_SECRET=

# FEDERATION_PEERS — static peer list, comma-separated. Only needed on a
#   "father" server that does not use peer_announce.
#   Example: wss://peer1.example.com,wss://peer2.example.com:4433
FEDERATION_PEERS=


# ─── Optional integrations ────────────────────────────────────────────────────

# TURN server for WebRTC calls behind symmetric NAT. Without it, calls fall
# back to direct/STUN connectivity and fail for some network topologies.
# TURN_SERVER=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# Firebase push notifications. Optional and OFF unless configured: the server
# only wakes a disconnected Android client, and the token is held in RAM only,
# never written to disk. Enabling it means Google learns which devices run
# this deployment and when they receive a push — a metadata exposure that is
# deliberately opt-in.
# FIREBASE_CREDENTIALS_JSON=path/to/firebase-credentials.json
