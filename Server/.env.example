# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env

# Опционально — федерация между серверами (оставь пустым если не нужно)
#
# FEDERATION_SECRET — общий секрет на ВСЕХ серверах (отец + сыновья). Одинаковый!
#   Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
FEDERATION_SECRET=
#
# FEDERATION_PEERS — статический список пиров (только для отца, если нет peer_announce).
#   Пример: wss://peer1.example.com,wss://peer2.example.com:4433
FEDERATION_PEERS=
#
# SERVER_URL — публичный WebSocket-адрес ЭТОГО сервера.
#   Нужен сыновьям: при подключении к отцу сын сообщает свой адрес через peer_announce,
#   чтобы клиенты получали актуальный список резервных серверов.
#   Пример: wss://myserver.ru  или  wss://myserver.ru:4433
SERVER_URL=
#
# SERVER_ACCESS_PROTECTED — опционально, для приватных/корпоративных инсталляций.
#   Если "true" — регистрация нового аккаунта (не реконнект уже известного) требует
#   одноразовый код доступа. Личным серверам не нужно — оставь пустым/false.
SERVER_ACCESS_PROTECTED=
#
# SERVER_ACCESS_CODE_COUNT — сколько одноразовых кодов сгенерировать при первом
#   запуске с SERVER_ACCESS_PROTECTED=true (например, 16 — по числу сотрудников).
#   Коды печатаются один раз в лог при старте. Выпустить ещё позже, без рестарта:
#   python3 Server/admin_gen_codes.py <N>
SERVER_ACCESS_CODE_COUNT=
#
# TOTP_SECRET_ENCRYPTION_KEY — опционально, шифрует TOTP-секреты (device-gated
#   registration protection) в SQLite в состоянии покоя. Без этой переменной
#   секреты хранятся как есть, открытым текстом (сервер и так обязан держать
#   сырой секрет для проверки кодов — это защищает именно копию на диске от
#   утечки файла БД отдельно от самого процесса).
#   Сгенерировать: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   ВАЖНО: держи это значение ОТДЕЛЬНО от того, что бэкапит саму БД —
#   если ключ и файл БД утекут вместе, шифрование не даёт ничего.
TOTP_SECRET_ENCRYPTION_KEY=
#
# DB_ENCRYPTION_KEY_HEX — опционально, шифрует всю БД (messages.db) at-rest через
#   SQLCipher. Защищает от кражи файла БД/бэкапа/диска на выключенном сервере — НЕ
#   защищает от root-доступа к уже запущенному процессу (ключ живёт в его памяти,
#   иначе сервер не смог бы читать собственные данные).
#   Требует пакет sqlcipher3-binary (см. requirements.txt).
#   Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
#   ВАЖНО: задавать один раз, до первого запуска с этой БД (или начинать с чистой
#   БД) — существующая незашифрованная БД с этим ключом не откроется.
DB_ENCRYPTION_KEY_HEX=
